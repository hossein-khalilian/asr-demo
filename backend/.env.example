# Backend settings. Copy to backend/.env; every value here is the default.

# Models (see config/models.json for the list and its fields)
ASR_MODELS_FILE=config/models.json
# Empty → the first model in the file.
ASR_DEFAULT_MODEL=
# default | all | none | comma-separated model ids. The rest load on first use.
ASR_PRELOAD=default
ASR_MAX_LOADED_MODELS=2
# auto | cuda | cpu
ASR_DEVICE=auto

# Limits
MAX_UPLOAD_MB=25
# NeMo decodes a clip in one pass; long audio can exhaust GPU memory. 0 = no limit.
MAX_AUDIO_SECONDS=600
MAX_QUEUE=16

# Bearer keys for /api/v1/*, comma-separated. Empty = no auth (local dev only).
# Generate one with: python -c "import secrets; print('sk-asr-' + secrets.token_urlsafe(32))"
API_KEYS=
CORS_ORIGINS=*
LOG_LEVEL=info

# Optional: Hugging Face token for private or rate-limited checkpoint downloads.
HF_TOKEN=
