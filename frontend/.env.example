# Server-side only: where the Next.js proxy forwards /api/v1/* and /api/health.
API_URL=http://localhost:8000
# Server-side only: sent as "Authorization: Bearer <key>" when the backend has
# API_KEYS set. Never exposed to the browser.
ASR_API_KEY=
# Seconds the proxy waits for the backend before answering 504. Transcription
# on CPU (long audio, beam search, a queue) can take many minutes.
ASR_PROXY_TIMEOUT_SECONDS=1800
