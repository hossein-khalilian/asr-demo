# Root settings for docker compose. Copy to .env.
# Backend runtime settings (API_KEYS, HF_TOKEN, models, limits) live in backend/.env.

# Compose project name. Give each checkout on a host its own (asr-demo-develop,
# asr-demo-main) so their containers, volumes and networks stay apart.
COMPOSE_PROJECT_NAME=asr-demo

# Dev stack: host user (bind-mount file ownership) and published ports.
UID=1000
GID=1000
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Prod stack: Traefik router names and the public host.
BRANCH=main
PUBLIC_URL=asr.example.com

# Key the frontend proxy sends to the backend. Must be one of backend/.env's
# API_KEYS (leave both empty for an open local setup).
ASR_API_KEY=

# Build sources. Clear REGISTRY (REGISTRY=) to pull base images from Docker Hub.
REGISTRY=docker.arvancloud.ir/
PIP_INDEX_URL=https://pypi.org/simple
# PIP_INDEX_URL=https://package-mirror.liara.ir/repository/pypi/simple
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
# Used by docker-compose.gpu.yml.
TORCH_GPU_INDEX_URL=https://download.pytorch.org/whl/cu126
